/* ============================================================
   Windows 98 / 2000 classic theme for GT3 Wheel Painter

   Palette (system colours of the "Windows Standard" scheme)
     ButtonFace      #c0c0c0     ButtonHighlight #ffffff
     ButtonLight     #dfdfdf     ButtonShadow    #808080
     ButtonDkShadow  #000000     Highlight       #000080
     Window          #ffffff     InfoBack        #ffffe1

   @ICONS@ is replaced with the absolute path of ui/icons/ at
   load time (see main.py), because Qt resolves url() against
   the current working directory, not against this file.

   Bevel convention (QSS only allows one colour per border side,
   so the classic two-pixel bevel is approximated):
     raised : top/left #ffffff   bottom/right #404040
     sunken : top/left #808080   bottom/right #ffffff
   ============================================================ */

* {
    font-family: "MS Sans Serif", "Microsoft Sans Serif", "Tahoma", "Segoe UI", sans-serif;
    font-size: 11px;
    color: #000000;
}

QMainWindow, QDialog, QWidget {
    background-color: #c0c0c0;
}

QWidget:disabled {
    color: #808080;
}

/* ---------- Menu bar & menus ---------- */

QMenuBar {
    background-color: #c0c0c0;
    border-bottom: 1px solid #808080;
    padding: 1px 0px;
    spacing: 0px;
}

QMenuBar::item {
    background: transparent;
    border: 1px solid transparent;
    padding: 3px 7px;
    margin: 0px;
}

/* Win9x menu-bar items go raised on hover and sunken when open */
QMenuBar::item:selected {
    border: 1px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #808080;
    border-bottom-color: #808080;
}

QMenuBar::item:pressed {
    border: 1px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 4px 6px 2px 8px;
}

QMenu {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #dfdfdf;
    border-left-color: #dfdfdf;
    border-right-color: #404040;
    border-bottom-color: #404040;
    padding: 2px;
}

QMenu::item {
    padding: 3px 30px 3px 22px;
    background-color: transparent;
    border: 0px;
}

QMenu::item:selected {
    background-color: #000080;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::item:disabled:selected {
    background-color: transparent;
    color: #808080;
}

QMenu::separator {
    height: 2px;
    margin: 3px 2px;
    border-top: 1px solid #808080;
    border-bottom: 1px solid #ffffff;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    left: 4px;
}

QMenu::indicator:checked {
    image: url(@ICONS@/check.png);
}

QMenu::right-arrow {
    image: url(@ICONS@/right.png);
    width: 4px;
    height: 7px;
    margin-right: 6px;
}

/* ---------- Tool bar (flat IE4-style buttons) ---------- */

QToolBar {
    background-color: #c0c0c0;
    border: 0px;
    border-top: 1px solid #ffffff;
    border-bottom: 1px solid #808080;
    spacing: 1px;
    padding: 2px;
}

QToolBar::separator {
    width: 2px;
    margin: 2px 4px;
    background-color: #808080;
    border-right: 1px solid #ffffff;
}

QToolBar::handle:horizontal {
    width: 3px;
    margin: 2px 3px;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #808080;
}

QToolButton {
    background-color: #c0c0c0;
    border: 1px solid transparent;
    padding: 3px 8px;
    min-height: 18px;
}

QToolButton:hover {
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #808080;
    border-bottom-color: #808080;
}

QToolButton:pressed,
QToolButton:checked {
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 4px 7px 2px 9px;
}

QToolButton:checked {
    background-color: #dfdfdf;
}

QToolButton:disabled {
    color: #808080;
    border-color: transparent;
}

/* ---------- Push buttons ---------- */

QPushButton {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    padding: 3px 12px;
    min-height: 17px;
    min-width: 62px;
}

QPushButton:pressed {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 4px 11px 2px 13px;
}

QPushButton:checked {
    background-color: #dfdfdf;
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QPushButton:disabled {
    color: #808080;
    border-top-color: #dfdfdf;
    border-left-color: #dfdfdf;
    border-right-color: #808080;
    border-bottom-color: #808080;
}

/* Default button: heavier black frame */
QPushButton:default {
    border: 3px solid;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 2px 11px;
}

QPushButton:default:pressed {
    padding: 3px 10px 1px 12px;
}

/* ---------- Labels, frames, group boxes ---------- */

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #808080;
}

QLabel#infoLabel {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 4px;
}

/* Classic etched (groove) group box with the title in the line */
QGroupBox {
    background-color: #c0c0c0;
    border: 2px groove #ffffff;
    border-style: groove;
    margin-top: 8px;
    padding-top: 6px;
    font-weight: normal;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0px 3px;
    color: #000000;
    background-color: #c0c0c0;
}

QGroupBox::title:disabled {
    color: #808080;
}

QFrame#sunkenPanel {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QFrame#raisedPanel {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
}

QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #808080;
    background-color: transparent;
}

/* ---------- Edit controls ---------- */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 1px 3px;
    selection-background-color: #000080;
    selection-color: #ffffff;
    min-height: 16px;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #c0c0c0;
    color: #808080;
}

QLineEdit:read-only {
    background-color: #c0c0c0;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 17px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 15px;
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    margin: 0px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 15px;
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    margin: 0px;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@ICONS@/spin_up.png);
    width: 5px;
    height: 3px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@ICONS@/spin_down.png);
    width: 5px;
    height: 3px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(@ICONS@/spin_up_dis.png);
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(@ICONS@/spin_down_dis.png);
}

/* ---------- Combo box ---------- */

QComboBox {
    background-color: #ffffff;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 1px 3px;
    min-height: 16px;
    selection-background-color: #000080;
    selection-color: #ffffff;
}

QComboBox:disabled {
    background-color: #c0c0c0;
    color: #808080;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 15px;
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    margin: 0px;
}

QComboBox::drop-down:on {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QComboBox::down-arrow {
    image: url(@ICONS@/down.png);
    width: 7px;
    height: 4px;
}

QComboBox::down-arrow:disabled {
    image: url(@ICONS@/down_dis.png);
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #000000;
    outline: 0px;
    selection-background-color: #000080;
    selection-color: #ffffff;
}

/* ---------- Lists, trees, tables ---------- */

QListView, QListWidget, QTreeView, QTreeWidget, QTableView, QTableWidget {
    background-color: #ffffff;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    outline: 0px;
    selection-background-color: #000080;
    selection-color: #ffffff;
    alternate-background-color: #ffffff;
}

QListView::item, QListWidget::item, QTreeView::item {
    padding: 1px 2px;
    border: 1px solid transparent;
}

QListView::item:selected, QListWidget::item:selected,
QTreeView::item:selected, QTableView::item:selected {
    background-color: #000080;
    color: #ffffff;
}

/* Selected row in an unfocused list stays navy, as in Win9x */
QListView::item:selected:!active, QListWidget::item:selected:!active,
QTreeView::item:selected:!active, QTableView::item:selected:!active {
    background-color: #000080;
    color: #ffffff;
}

QListView::item:hover, QListWidget::item:hover {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    padding: 1px 4px;
    min-height: 15px;
}

QHeaderView::section:pressed {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QTableCornerButton::section {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    top: -2px;
}

QTabBar::tab {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom: none;
    padding: 2px 8px;
    margin-top: 2px;
    margin-right: 0px;
    min-height: 15px;
}

QTabBar::tab:selected {
    margin-top: 0px;
    margin-left: -2px;
    margin-right: -2px;
    padding: 4px 10px 2px 10px;
}

QTabBar::tab:first:selected {
    margin-left: 0px;
}

QTabBar::tab:!selected:hover {
    color: #000000;
}

/* ---------- Status bar ---------- */

QStatusBar {
    background-color: #c0c0c0;
    border-top: 1px solid #ffffff;
    min-height: 22px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background-color: #c0c0c0;
    border: 1px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    padding: 1px 6px;
    margin: 1px 1px;
    min-height: 15px;
}

QSizeGrip {
    background-color: transparent;
    width: 12px;
    height: 12px;
}

/* ---------- Splitter, dock widgets ---------- */

QSplitter::handle {
    background-color: #c0c0c0;
}

QSplitter::handle:horizontal {
    width: 5px;
}

QSplitter::handle:vertical {
    height: 5px;
}

QDockWidget {
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #000080;
    color: #ffffff;
    padding: 2px 4px;
    font-weight: bold;
}

/* ---------- Scroll bars (dithered track, bevelled arrows) ---------- */

QScrollBar:vertical {
    background-color: #dfdfdf;
    width: 16px;
    margin: 16px 0px 16px 0px;
    border: 0px;
}

QScrollBar:horizontal {
    background-color: #dfdfdf;
    height: 16px;
    margin: 0px 16px 0px 16px;
    border: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    min-height: 20px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    min-width: 20px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background-color: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical  { height: 16px; subcontrol-position: bottom; }
QScrollBar::sub-line:vertical  { height: 16px; subcontrol-position: top; }
QScrollBar::add-line:horizontal { width: 16px; subcontrol-position: right; }
QScrollBar::sub-line:horizontal { width: 16px; subcontrol-position: left; }

QScrollBar::add-line:pressed, QScrollBar::sub-line:pressed {
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #808080;
    border-bottom-color: #808080;
}

QScrollBar::up-arrow:vertical    { image: url(@ICONS@/up.png);    width: 7px; height: 4px; }
QScrollBar::down-arrow:vertical  { image: url(@ICONS@/down.png);  width: 7px; height: 4px; }
QScrollBar::left-arrow:horizontal  { image: url(@ICONS@/left.png);  width: 4px; height: 7px; }
QScrollBar::right-arrow:horizontal { image: url(@ICONS@/right.png); width: 4px; height: 7px; }

/* ---------- Dialogs ---------- */

QMessageBox, QFileDialog, QColorDialog, QInputDialog {
    background-color: #c0c0c0;
}

QMessageBox QLabel {
    color: #000000;
}

QOpenGLWidget {
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    background-color: #000000;
}

/* ---------- Check boxes / radio buttons ---------- */

QCheckBox, QRadioButton {
    spacing: 6px;
    background: transparent;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #ffffff;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

QCheckBox::indicator:checked {
    image: url(@ICONS@/check.png);
}

QCheckBox::indicator:disabled {
    background-color: #c0c0c0;
}

QCheckBox::indicator:checked:disabled {
    image: url(@ICONS@/check_dis.png);
}

QCheckBox::indicator:indeterminate {
    background-color: #c0c0c0;
}

QRadioButton::indicator {
    width: 11px;
    height: 11px;
    background-color: #ffffff;
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    image: url(@ICONS@/radio_dot.png);
}

/* ---------- Sliders ---------- */

QSlider::groove:horizontal {
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    height: 2px;
    background: #c0c0c0;
    margin: 0px 4px;
}

QSlider::handle:horizontal {
    background: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    width: 7px;
    margin: -9px -2px;
}

QSlider::groove:vertical {
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    width: 2px;
    background: #c0c0c0;
    margin: 4px 0px;
}

QSlider::handle:vertical {
    background: #c0c0c0;
    border: 2px solid;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    height: 7px;
    margin: -2px -9px;
}

/* ---------- Progress bar (blue blocks) ---------- */

QProgressBar {
    border: 2px solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
    background-color: #c0c0c0;
    text-align: center;
    min-height: 15px;
}

QProgressBar::chunk {
    background-color: #000080;
    width: 8px;
    margin: 0px 1px;
}

/* ---------- Tool tips ---------- */

QToolTip {
    background-color: #ffffe1;
    color: #000000;
    border: 1px solid #000000;
    padding: 1px 3px;
}
